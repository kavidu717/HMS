// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          BigInt   @id @default(autoincrement())
  name        String   @unique @db.VarChar(50)
  description String?  @db.VarChar(255)
  privileges  Json     @default("[]")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("roles")
}

model User {
  id           BigInt    @id @default(autoincrement())
  username     String    @unique @db.VarChar(100)
  email        String    @unique @db.VarChar(150)
  passwordHash String?   @map("password_hash") @db.VarChar(255)
  roleId       BigInt    @map("role_id")
  status       String    @db.VarChar(20)
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  role              Role              @relation(fields: [roleId], references: [id])
  invitations       UserInvitation[]
  uploadedDocuments PatientDocument[]
  doctor            Doctor?
  employee Employee?
  approvedLeaveRecords EmployeeLeaveRecord[] @relation("LeaveRecordApprover")

  @@map("users")
}

model UserInvitation {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("user_invitations")
}

model Patient {
  id                    BigInt   @id @default(autoincrement())
  patientNumber         String   @unique @map("patient_number") @db.VarChar(50)
  firstName             String   @map("first_name") @db.VarChar(100)
  lastName              String   @map("last_name") @db.VarChar(100)
  dateOfBirth           DateTime @map("date_of_birth")
  gender                String   @db.VarChar(20)
  nic                   String?  @unique @db.VarChar(20)
  phone                 String   @db.VarChar(20)
  email                 String?  @db.VarChar(150)
  address               String?  @db.VarChar(255)
  emergencyContactName  String?  @map("emergency_contact_name") @db.VarChar(150)
  emergencyContactPhone String?  @map("emergency_contact_phone") @db.VarChar(20)
  status                String   @db.VarChar(20)
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  medicalRecords MedicalRecord[]
  prescriptions Prescription[]
  documents      PatientDocument[]
  appointments   Appointment[]
  laboratoryTestRequests LaboratoryTestRequest[]
  invoices Invoice[]

  @@index([firstName, lastName])
  @@index([phone])
  @@index([patientNumber])
  @@map("patients")
}

model MedicalRecord {
  id         BigInt   @id @default(autoincrement())
  patientId  BigInt   @map("patient_id")
  diagnosis  String?  @db.Text
  symptoms   String?  @db.Text
  treatment  String?  @db.Text
  notes      String?  @db.Text
  recordedAt DateTime @default(now()) @map("recorded_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
     
  prescriptions Prescription[]

  @@index([patientId])
  @@index([recordedAt])
  @@map("medical_records")
}

model PatientDocument {
  id         BigInt   @id @default(autoincrement())
  patientId  BigInt   @map("patient_id")
  fileName   String   @map("file_name") @db.VarChar(255)
  fileType   String   @map("file_type") @db.VarChar(100)
  fileSize   Int      @map("file_size")
  s3Key      String   @unique @map("s3_key") @db.VarChar(500)
  uploadedBy BigInt   @map("uploaded_by")
  createdAt  DateTime @default(now()) @map("created_at")

  patient  Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  uploader User    @relation(fields: [uploadedBy], references: [id])

  @@index([patientId])
  @@index([uploadedBy])
  @@map("patient_documents")
}

model Doctor {
  id             BigInt   @id @default(autoincrement())
  userId         BigInt   @unique @map("user_id")
  doctorNumber   String   @unique @map("doctor_number") @db.VarChar(50)
  firstName      String   @map("first_name") @db.VarChar(100)
  lastName       String   @map("last_name") @db.VarChar(100)
  specialization String   @db.VarChar(100)
  phone          String   @db.VarChar(20)
  email          String   @db.VarChar(150)
  departmentId   BigInt?  @map("department_id")
  status         String   @default("ACTIVE") @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user         User             @relation(fields: [userId], references: [id])
  department   Department?      @relation(fields: [departmentId], references: [id])
  schedules    DoctorSchedule[]
  appointments Appointment[]
  prescriptions Prescription[]
  laboratoryTestRequests LaboratoryTestRequest[]

  @@index([departmentId])
  @@index([specialization])
  @@map("doctors")
}

model Department {
  id          BigInt   @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(500)
  status      String   @default("ACTIVE") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  doctors Doctor[]
  employees Employee[]

  @@map("departments")
}

model DoctorSchedule {
  id        BigInt   @id @default(autoincrement())
  doctorId  BigInt   @map("doctor_id")
  dayOfWeek Int      @map("day_of_week")
  startTime String   @map("start_time") @db.VarChar(5)
  endTime   String   @map("end_time") @db.VarChar(5)
  status    String   @default("ACTIVE") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId])
  @@index([dayOfWeek])
  @@map("doctor_schedules")
}

model Appointment {
  id                BigInt   @id @default(autoincrement())
  appointmentNumber String   @unique @map("appointment_number") @db.VarChar(50)
  patientId         BigInt   @map("patient_id")
  doctorId          BigInt   @map("doctor_id")
  appointmentDate   DateTime @map("appointment_date") @db.Date
  startTime         String   @map("start_time") @db.VarChar(5)
  endTime           String   @map("end_time") @db.VarChar(5)
  reason            String?  @db.Text
  status            String   @default("SCHEDULED") @db.VarChar(20)
  notes             String?  @db.Text
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  patient Patient @relation(fields: [patientId], references: [id])
  doctor  Doctor  @relation(fields: [doctorId], references: [id])

  @@index([patientId])
  @@index([doctorId])
  @@index([appointmentDate])
  @@index([status])
  @@map("appointments")
}

model Prescription {
  id                BigInt   @id @default(autoincrement())
  prescriptionNumber String  @unique @map("prescription_number") @db.VarChar(50)
  patientId         BigInt   @map("patient_id")
  doctorId          BigInt   @map("doctor_id")
  medicalRecordId   BigInt?  @map("medical_record_id")
  medicineName      String   @map("medicine_name") @db.VarChar(255)
  dosage            String   @db.VarChar(100)
  frequency         String   @db.VarChar(100)
  duration          String   @db.VarChar(100)
  quantity          Int?
  instructions      String?  @db.Text
  status            String   @default("ACTIVE") @db.VarChar(20)
  prescribedAt      DateTime @default(now()) @map("prescribed_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  patient       Patient       @relation(fields: [patientId], references: [id])
  doctor        Doctor        @relation(fields: [doctorId], references: [id])
  medicalRecord MedicalRecord? @relation(fields: [medicalRecordId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([doctorId])
  @@index([medicalRecordId])
  @@index([prescribedAt])
  @@index([status])
  @@map("prescriptions")
}

model LaboratoryTest {
  id          BigInt   @id @default(autoincrement())
  testCode    String   @unique @map("test_code") @db.VarChar(50)
  testName    String   @map("test_name") @db.VarChar(150)
  description String?  @db.Text
  sampleType  String   @map("sample_type") @db.VarChar(100)
  price       Decimal  @default(0) @db.Decimal(10, 2)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  requests LaboratoryTestRequest[]

  @@index([testName])
  @@index([isActive])
  @@map("laboratory_tests")
}

model LaboratoryTestRequest {
  id                BigInt    @id @default(autoincrement())
  requestNumber     String    @unique @map("request_number") @db.VarChar(50)
  patientId         BigInt    @map("patient_id")
  doctorId          BigInt    @map("doctor_id")
  laboratoryTestId  BigInt    @map("laboratory_test_id")
  status            String    @default("REQUESTED") @db.VarChar(30)
  sampleCollectedAt DateTime? @map("sample_collected_at")
  result            String?   @db.Text
  resultEnteredAt   DateTime? @map("result_entered_at")
  requestedAt       DateTime  @default(now()) @map("requested_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  patient       Patient       @relation(fields: [patientId], references: [id])
  doctor        Doctor        @relation(fields: [doctorId], references: [id])
  laboratoryTest LaboratoryTest @relation(fields: [laboratoryTestId], references: [id])

  @@index([patientId])
  @@index([doctorId])
  @@index([laboratoryTestId])
  @@index([status])
  @@index([requestedAt])
  @@map("laboratory_test_requests")
}

model Medicine {
  id          BigInt   @id @default(autoincrement())
  medicineCode String  @unique @map("medicine_code") @db.VarChar(50)
  medicineName String  @map("medicine_name") @db.VarChar(150)
  brandName   String   @map("brand_name") @db.VarChar(150)
  genericName String   @map("generic_name") @db.VarChar(150)
  category    String   @db.VarChar(100)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  variants MedicineVariant[]

  @@index([medicineName])
  @@index([genericName])
  @@index([category])
  @@index([isActive])
  @@map("medicines")
}

model MedicineVariant {
  id          BigInt   @id @default(autoincrement())
  medicineId  BigInt   @map("medicine_id")
  strength    String   @db.VarChar(50)
  dosageForm  String   @map("dosage_form") @db.VarChar(50)
  unit        String   @db.VarChar(30)
  reorderLevel Int     @default(0) @map("reorder_level")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  medicine Medicine @relation(fields: [medicineId], references: [id])
   batches  MedicineBatch[]

  @@unique([medicineId, strength, dosageForm])
  @@index([medicineId])
  @@index([isActive])
  @@map("medicine_variants")
}

model MedicineBatch {
  id                BigInt   @id @default(autoincrement())
  medicineVariantId BigInt   @map("medicine_variant_id")
  batchNumber       String   @map("batch_number") @db.VarChar(100)
  quantity          Int      @default(0)
  purchasePrice     Decimal  @map("purchase_price") @db.Decimal(10, 2)
  sellingPrice      Decimal  @map("selling_price") @db.Decimal(10, 2)
  expiryDate        DateTime @map("expiry_date") @db.Date
  receivedAt        DateTime @default(now()) @map("received_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  medicineVariant MedicineVariant @relation(fields: [medicineVariantId], references: [id])
  stockMovements  StockMovement[]

  @@unique([medicineVariantId, batchNumber])
  @@index([medicineVariantId])
  @@index([expiryDate])
  @@index([quantity])
  @@map("medicine_batches")
}

model StockMovement {
  id              BigInt   @id @default(autoincrement())
  medicineBatchId BigInt   @map("medicine_batch_id")
  movementType    String   @map("movement_type") @db.VarChar(30)
  quantityChange  Int      @map("quantity_change")
  reason          String?  @db.VarChar(255)
  referenceNumber String?  @map("reference_number") @db.VarChar(100)
  createdAt       DateTime @default(now()) @map("created_at")

  medicineBatch MedicineBatch @relation(fields: [medicineBatchId], references: [id])

  @@index([medicineBatchId])
  @@index([movementType])
  @@index([createdAt])
  @@map("stock_movements")
}

model Invoice {
  id            BigInt        @id @default(autoincrement())
  invoiceNumber String        @unique @map("invoice_number") @db.VarChar(50)
  patientId     BigInt        @map("patient_id")
  invoiceDate   DateTime      @default(now()) @map("invoice_date")
  totalAmount   Decimal       @default(0) @map("total_amount") @db.Decimal(10, 2)
  paidAmount    Decimal       @default(0) @map("paid_amount") @db.Decimal(10, 2)
  balanceAmount Decimal       @default(0) @map("balance_amount") @db.Decimal(10, 2)
  status        String        @default("UNPAID") @db.VarChar(20)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  patient Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  items   InvoiceItem[]
  payments Payment[]

  @@index([patientId])
  @@index([invoiceDate])
  @@index([status])
  @@map("invoices")
}

model InvoiceItem {
  id          BigInt   @id @default(autoincrement())
  invoiceId   BigInt   @map("invoice_id")
  category    String   @db.VarChar(30)
  description String   @db.VarChar(255)
  quantity    Int      @default(1)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(10, 2)
  amount      Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([category])
  @@map("invoice_items")
}

model Payment {
  id              BigInt   @id @default(autoincrement())
  paymentNumber   String   @unique @map("payment_number") @db.VarChar(50)
  invoiceId       BigInt   @map("invoice_id")
  amount          Decimal  @db.Decimal(10, 2)
  paymentMethod   String   @map("payment_method") @db.VarChar(30)
  referenceNumber String?  @map("reference_number") @db.VarChar(100)
  paidAt          DateTime @default(now()) @map("paid_at")
  createdAt       DateTime @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([paidAt])
  @@map("payments")
}

model Employee {
  id             BigInt   @id @default(autoincrement())
  userId         BigInt   @unique @map("user_id")
  employeeNumber String   @unique @map("employee_number") @db.VarChar(50)
  firstName      String   @map("first_name") @db.VarChar(100)
  lastName       String   @map("last_name") @db.VarChar(100)
  position       String   @db.VarChar(100)
  phone          String   @db.VarChar(20)
  email          String   @db.VarChar(150)
  departmentId   BigInt?  @map("department_id")
  status         String   @default("ACTIVE") @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user       User        @relation(fields: [userId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  attendance Attendance[]
  leaveRecords EmployeeLeaveRecord[]


  @@index([departmentId])
  @@map("employees")
}

model Attendance {
  id         BigInt   @id @default(autoincrement())
  employeeId BigInt   @map("employee_id")
  date       DateTime @db.Date
  checkIn    DateTime? @map("check_in")
  checkOut   DateTime? @map("check_out")
  status     String   @default("PRESENT") @db.VarChar(20)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date])
  @@index([date])
  @@map("attendance")
}


model EmployeeLeaveRecord {
  id          BigInt   @id @default(autoincrement())
  employeeId  BigInt   @map("employee_id")
  leaveType   String   @map("leave_type") @db.VarChar(50)
  startDate   DateTime @map("start_date") @db.Date
  endDate     DateTime @map("end_date") @db.Date
  reason      String?  @db.Text
  status      String   @default("PENDING") @db.VarChar(20)
  approvedBy  BigInt?  @map("approved_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id])
  approver User?    @relation("LeaveRecordApprover", fields: [approvedBy], references: [id])

  @@index([employeeId])
  @@index([status])
  @@index([startDate, endDate])
  @@map("employee_leave_records")
}